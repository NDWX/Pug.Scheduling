<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Product>Pug.Scheduling</Product>
		<Title>Pug.Scheduling.Leases</Title>
		<Authors>Andrian</Authors>
		<Description>Database-backed execution lease provider for the Pug.Scheduling job scheduling framework.</Description>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/NDWX/Pug.Scheduling.git</RepositoryUrl>
		<AssemblyVersion>0.0.0.1</AssemblyVersion>
		<FileVersion>0.0.0.1</FileVersion>
		<PackageVersion>0.0.1</PackageVersion>
		<PackageTags>Pug Scheduling Framework Lease</PackageTags>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<License>Apache2.0</License>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="../Pug.Scheduling.Abstractions/Pug.Scheduling.Abstractions.csproj" />
		<ProjectReference Include="../Pug.Scheduling.Leases.Data.Abstractions/Pug.Scheduling.Leases.Data.Abstractions.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Pug.Application.Data.Extensions" Version="1.0.0" />
	</ItemGroup>

</Project>
