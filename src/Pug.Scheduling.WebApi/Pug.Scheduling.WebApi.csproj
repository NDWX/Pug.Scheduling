<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<Product>Pug.Scheduling</Product>
		<Title>Pug.Scheduling.WebApi</Title>
		<Authors>Andrian</Authors>
		<Description>Minimal API endpoints for the Pug.Scheduling schedule management and execution coordinator surfaces.</Description>
		<RepositoryType>Git</RepositoryType>
		<RepositoryUrl>https://github.com/NDWX/Pug.Scheduling.git</RepositoryUrl>
		<AssemblyVersion>0.0.0.1</AssemblyVersion>
		<FileVersion>0.0.0.1</FileVersion>
		<PackageVersion>0.0.1</PackageVersion>
		<PackageTags>Pug Scheduling Framework Web API</PackageTags>
		<PackageLicenseExpression>Apache-2.0+</PackageLicenseExpression>
		<License>Apache2.0</License>
		<PackageRequireLicenseAcceptance>true</PackageRequireLicenseAcceptance>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Pug.Application.Security.Abstractions" Version="3.1.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="../Pug.Scheduling.Abstractions/Pug.Scheduling.Abstractions.csproj" />
		<ProjectReference Include="../Pug.Scheduling.WebApi.Models/Pug.Scheduling.WebApi.Models.csproj" />
	</ItemGroup>

</Project>
